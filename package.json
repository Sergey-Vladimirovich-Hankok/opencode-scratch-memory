{
  "name": "opencode-scratch-memory",
  "version": "0.1.0",
  "description": "opencode plugin: session-scoped scratch memory for subagents — ephemeral SQLite scratchpad (paths, commands, baselines, progress) that survives context compaction and crashes, wiped on clean exit.",
  "type": "module",
  "main": "src/scratch-plugin.js",
  "exports": {
    ".": "./src/scratch-plugin.js"
  },
  "files": [
    "src",
    "tests",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergey-Vladimirovich-Hankok/opencode-scratch-memory.git"
  },
  "homepage": "https://github.com/Sergey-Vladimirovich-Hankok/opencode-scratch-memory#readme",
  "bugs": {
    "url": "https://github.com/Sergey-Vladimirovich-Hankok/opencode-scratch-memory/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "subagent",
    "agent",
    "memory",
    "scratch",
    "scratchpad",
    "notepad",
    "context-management",
    "context-compaction",
    "session",
    "session-scoped",
    "ephemeral",
    "bun",
    "sqlite",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build src/scratch-plugin.js --target=bun --outdir=dist"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@types/bun": "1.4.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}